# AI analysis provider (used by app/api/ai/analyze).
# Copy to .env.local and fill in. Set the same values in the Render dashboard.
RIVER_BASE_URL=https://api.river.ai/v1
RIVER_API_KEY=
RIVER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# Convex Auth (Google sign-in). Optional — the demo sign-in works without it.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
